# Local-dev env (host machine). Mirrors the docker-compose `consumer-nuxt`
# environment block but resolves every dependency via host-published ports.
# Stop the dockerised peer first: `docker compose stop consumer-nuxt`
# so this process can bind 3003 and own the `nuxt` AMQP queue.

PORT=3003
NUXT_PORT=3003
HOST=0.0.0.0
NITRO_HOST=0.0.0.0
NITRO_PORT=3003

AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=guest
AMQP_PASSWORD=guest
AMQP_PROTOCOL=amqp
AMQP_QUEUE=nuxt
PROPAGATION_SECRET=secret-of-nuxt

REDIS_URL=redis://localhost:6381
HMAC_SECRET_TOKEN=mesh-pepper-shared

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=nuxt_db

PEER_REDIS_URLS=redis://localhost:6379,redis://localhost:6380,redis://localhost:6381,redis://localhost:6382
