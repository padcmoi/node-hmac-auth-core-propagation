# Local-dev env (host machine). Mirrors the docker-compose `consumer-next`
# environment block but resolves every dependency via host-published ports.
# Stop the dockerised peer first: `docker compose stop consumer-next`
# so this process can bind 33004 and own the `next` AMQP queue.

PORT=33004
HOSTNAME=0.0.0.0

AMQP_HOST=localhost
AMQP_PORT=35672
AMQP_USER=guest
AMQP_PASSWORD=guest
AMQP_PROTOCOL=amqp
AMQP_QUEUE=next
PROPAGATION_SECRET=secret-of-next

REDIS_URL=redis://localhost:36382
HMAC_SECRET_TOKEN=pepper-of-next

DB_HOST=localhost
DB_PORT=33306
DB_USER=root
DB_PASSWORD=root
DB_NAME=next_db

PEER_REDIS_URLS=redis://localhost:36379,redis://localhost:36380,redis://localhost:36381,redis://localhost:36382
