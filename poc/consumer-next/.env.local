# Local-dev env (host machine). Mirrors the docker-compose `consumer-next`
# environment block but resolves every dependency via host-published ports.
# Stop the dockerised peer first: `docker compose stop consumer-next`
# so this process can bind 3004 and own the `next` AMQP queue.

PORT=3004
HOSTNAME=0.0.0.0

AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=guest
AMQP_PASSWORD=guest
AMQP_PROTOCOL=amqp
AMQP_QUEUE=next
PROPAGATION_SECRET=secret-of-next

REDIS_URL=redis://localhost:6382
HMAC_SECRET_TOKEN=mesh-pepper-shared

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=next_db

PEER_REDIS_URLS=redis://localhost:6379,redis://localhost:6380,redis://localhost:6381,redis://localhost:6382
